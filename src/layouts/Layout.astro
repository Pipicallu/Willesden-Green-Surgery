---
// @ts-nocheck
import "../styles/global.css";
import ThemeToggle from "@/components/molecules/ThemeToggle";
import Navbar from "@/components/organisms/Navbar";
import Footer from "@/components/organisms/Footer";
import FloatingActionButton from "@/components/organisms/FloatingActionButton";
import { useStoryblokApi } from "@storyblok/astro";
import { dynamicNavLinkSorter } from "@/lib/dynamicNavLinks/dynamicNavLinkSorter";

// Fetch patient corner pages for the dropdown
const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/links/");
const links = data.links;
// console.log({ links }); // Debug log to check fetched links
const pages = dynamicNavLinkSorter(links);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charSet="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cabin:ital,wght@1,700&display=swap"
      rel="stylesheet"
    />
    <title>Willsden Green Surgery</title>
  </head>
  <body>
    <header class="fixed inset-x-0 top-0 z-50">
      <Navbar client:load pages={pages} />
    </header>
    <slot name="banner" />
    <section class="py-20 pt-20 pb-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <slot />
      </div>
    </section>
    <Footer client:load pages={pages} />
    <FloatingActionButton client:load />
  </body>
</html>

<style>
  html,
  body {
    background: linear-gradient(180deg, hsl(var(--wash)), hsl(var(--background)) 80vh);
    min-height: 100vh;
  }

  :global(.dark) body {
    background: linear-gradient(180deg, hsl(var(--secondary) / 0.2), transparent 80vh),
      hsl(var(--background));
  }
</style>
