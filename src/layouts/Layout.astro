---
// @ts-nocheck
import "../styles/global.css";
import ThemeToggle from "@/components/molecules/ThemeToggle";
import Navbar from "@/components/organisms/Navbar";
import { useStoryblokApi } from "@storyblok/astro";

// Fetch patient corner pages for the dropdown
const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/links/");
const links = data.links;

const patientCornerPages = Object.keys(links)
  .map((key) => links[key])
  .filter((link) => link.slug && link.slug.startsWith("patient-corner/"))
  .map((link) => ({
    title: link.name,
    slug: link.slug.replace("patient-corner/", ""),
  }));
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charSet="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Willsden Green Surgery</title>
  </head>
  <body>
    <Navbar client:load patientCornerPages={patientCornerPages} />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    background:
      radial-gradient(
        ellipse 80% 50% at 50% 0%,
        hsl(239 84% 67% / 0.25),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 0% 100%,
        hsl(239 84% 67% / 0.12),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 100% 100%,
        hsl(239 84% 67% / 0.12),
        transparent
      ),
      hsl(var(--background));
    background-attachment: fixed;
    min-height: 100vh;
    transition: background 0.3s ease;
  }

  .dark body {
    background:
      radial-gradient(
        ellipse 80% 50% at 50% 0%,
        hsl(239 84% 67% / 0.2),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 0% 100%,
        hsl(239 84% 67% / 0.1),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 100% 100%,
        hsl(239 84% 67% / 0.1),
        transparent
      ),
      hsl(var(--background));
    background-attachment: fixed;
  }
</style>
