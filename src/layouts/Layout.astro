---
// @ts-nocheck
import "../styles/global.css";
import Navbar from "@/components/organisms/Navbar";
import Footer from "@/components/organisms/Footer";
import FloatingActionButton from "@/components/organisms/FloatingActionButton";
import { useStoryblokApi } from "@storyblok/astro";
import { dynamicNavLinkSorter } from "@/lib/dynamicNavLinks/dynamicNavLinkSorter";

// Fetch patient corner pages for the dropdown
const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/links/");
const links = data.links;
// console.log({ links }); // Debug log to check fetched links
const pages = dynamicNavLinkSorter(links);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charSet="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cabin:ital,wght@1,700&family=Source+Sans+3:wght@400;600&family=Source+Serif+4:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <title>Willsden Green Surgery</title>
  </head>
  <body class="overflow-x-clip">
    <header class="fixed inset-x-0 top-4 z-50 flex justify-center pointer-events-none">
      <Navbar client:load pages={pages} />
    </header>
    <slot name="banner" />
    <section class="py-20 pt-20 pb-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <slot />
      </div>
    </section>
    <Footer client:load pages={pages} />
    <FloatingActionButton client:load />
  </body>
</html>
