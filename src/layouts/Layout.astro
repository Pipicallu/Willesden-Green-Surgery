---
// @ts-nocheck
import "../styles/global.css";
import ThemeToggle from "@/components/molecules/ThemeToggle";
import Navbar from "@/components/organisms/Navbar";
import Footer from "@/components/organisms/Footer";
import FloatingActionButton from "@/components/organisms/FloatingActionButton";
import { useStoryblokApi } from "@storyblok/astro";

// Fetch patient corner pages for the dropdown
const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/links/");
const links = data.links;

const patientCornerPages = Object.keys(links)
  .map((key) => links[key])
  .filter((link) => link.slug && link.slug.startsWith("patient-corner/"))
  .map((link) => ({
    title:
      link.name.replace(/-/g, " ").charAt(0).toUpperCase() +
      link.name.replace(/-/g, " ").slice(1), // split out into its own function if this gets more complex
    slug: link.slug.replace("patient-corner/", ""),
  }));
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charSet="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Willsden Green Surgery</title>
  </head>
  <body>
    <Navbar client:load patientCornerPages={patientCornerPages} />
    <section class="py-20 pt-20 pb-4">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </section>
    <Footer patientCornerPages={patientCornerPages} client:load />
    <FloatingActionButton client:load />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    background:
      radial-gradient(
        ellipse 80% 50% at 50% 0%,
        hsl(239 100% 70% / 0.7),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 0% 100%,
        hsl(262 100% 65% / 0.45),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 100% 100%,
        hsl(239 100% 65% / 0.45),
        transparent
      ),
      hsl(var(--background));
    background-attachment: fixed;
    min-height: 100vh;
    transition: background 0.3s ease;
  }

  :global(.dark) body {
    background:
      radial-gradient(
        ellipse 80% 50% at 50% 0%,
        hsl(239 100% 70% / 0.5),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 0% 100%,
        hsl(262 100% 65% / 0.3),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 100% 100%,
        hsl(239 100% 65% / 0.3),
        transparent
      ),
      hsl(var(--background));
    background-attachment: fixed;
  }
</style>
