---
// @ts-nocheck
import "../styles/global.css";
import ThemeToggle from "@/components/molecules/ThemeToggle";
import Navbar from "@/components/organisms/Navbar";
import Footer from "@/components/organisms/Footer";
import FloatingActionButton from "@/components/organisms/FloatingActionButton";
import { useStoryblokApi } from "@storyblok/astro";
import { dynamicNavLinkSorter } from "@/lib/dynamicNavLinks/dynamicNavLinkSorter";

// Fetch patient corner pages for the dropdown
const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/links/");
const links = data.links;
console.log({ links }); // Debug log to check fetched links
const pages = dynamicNavLinkSorter(links);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charSet="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cabin:ital,wght@1,700&display=swap"
      rel="stylesheet"
    />
    <title>Willsden Green Surgery</title>
  </head>
  <body>
    <Navbar client:load pages={pages} />
    <slot name="banner" />
    <section class="py-20 pt-20 pb-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <slot />
      </div>
    </section>
    <Footer client:load pages={pages} />
    <FloatingActionButton client:load />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body {
    background:
      radial-gradient(
        ellipse 80% 50% at 50% 0%,
        hsl(239 100% 70% / 0.7),
        transparent
      ),
      radial-gradient(
        ellipse 70% 60% at 0% 100%,
        hsl(262 100% 65% / 0.65),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 100% 100%,
        hsl(239 100% 65% / 0.45),
        transparent
      ),
      hsl(var(--background));
    background-attachment: fixed;
    min-height: 100vh;
    transition: background 0.3s ease;
  }

  :global(.dark) body {
    background:
      radial-gradient(
        ellipse 80% 50% at 50% 0%,
        hsl(239 100% 70% / 0.5),
        transparent
      ),
      radial-gradient(
        ellipse 70% 60% at 0% 100%,
        hsl(262 100% 65% / 0.45),
        transparent
      ),
      radial-gradient(
        ellipse 50% 50% at 100% 100%,
        hsl(239 100% 65% / 0.3),
        transparent
      ),
      hsl(var(--background));
    background-attachment: fixed;
  }
</style>
