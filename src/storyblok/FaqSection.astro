---
import { storyblokEditable } from "@storyblok/astro";
const { blok } = Astro.props;
import Faq from "@/components/organisms/faq";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
---

<section {...storyblokEditable(blok)} class="py-8">
  {
    blok.title && blok.subtitle && (
      <div class="mx-auto text-center space-y-8 mb-8">
        <h2 class="text-4xl font-bold">{blok.title}</h2>
        <p class="text-lg text-muted-foreground">{blok.subtitle}</p>
      </div>
    )
  }
  <Faq faqs={blok.faqs} client:load />

  <!-- Render nested bloks (DownloadIcon and Registration Options) -->
  {
    blok.body?.map((nestedBlok: any) => (
      <StoryblokComponent blok={nestedBlok} />
    ))
  }
</section>
