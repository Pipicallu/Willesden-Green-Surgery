---
import { storyblokEditable } from "@storyblok/astro";
import { Button } from "@/components/atoms/button";
import AppearOnScrollWrapper from "@/components/atoms/AppearOnScrollWrapper";
import { Title } from "@/components/atoms/Title";
import { Subtitle } from "@/components/atoms/Subtitle";
const { blok } = Astro.props;
type Card = {
  icon?: string;

  heading?: string;

  description?: string;

  link?: string;
};
---

<section
  class="min-h-screen flex items-center justify-center px-4"
  {...storyblokEditable(blok)}
>
  <div class="max-w-4xl mx-auto text-center space-y-12">
    <div class="space-y-6">
      <Title as="h1" className="text-5xl md:text-6xl tracking-tight">
        {blok.title}
      </Title>
      <Subtitle className="text-xl max-w-2xl mx-auto">
        {blok.subtitle}
      </Subtitle>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-3xl mx-auto">
      {
        blok.cards?.map((card: Card, index: number) => (
          <AppearOnScrollWrapper
            client:visible
            className="w-full h-full"
            transitionDuration={500 + index * 500}
          >
            <a
              href={card.link || "#"}
              data-slot="link"
              class="flex flex-col items-center text-center gap-4 group p-6 rounded-lg border bg-card hover:bg-accent transition-colors h-full"
            >
              <div class="[&_svg]:w-8 [&_svg]:h-8" set:html={card.icon} />
              <div>
                <h2 class="text-lg font-semibold mb-2 group-hover:text-accent-foreground">
                  {card.heading}
                </h2>
                <p class="text-sm text-muted-foreground">{card.description}</p>
              </div>
            </a>
          </AppearOnScrollWrapper>
        ))
      }
    </div>

    {
      blok.show_button && (
        <div class="pt-6">
          <Button
            client:load
            size="lg"
            variant="default"
            className="text-base px-8"
          >
            {blok.button_text}
          </Button>
        </div>
      )
    }
  </div>
</section>
