---
import { storyblokEditable } from '@storyblok/astro'
import { Button } from '@/components/ui/button'
import AppearOnScrollWrapper from '@/components/ui/AppearOnScrollWrapper'
const { blok } = Astro.props
type Card = {

  icon?: string

  heading?: string

  description?: string

  link?: string

}
---

<section
  class="min-h-screen flex items-center justify-center px-4"
  {...storyblokEditable(blok)}
>
  <div class="max-w-4xl mx-auto text-center space-y-12">
    <div class="space-y-6">
      <h1 class="text-5xl md:text-6xl font-bold tracking-tight">
        {blok.title}
      </h1>
      <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
        {blok.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-3xl mx-auto">
      {
        blok.cards?.map((card: Card, index: number) => (
          <AppearOnScrollWrapper client:visible className="w-full h-full" transitionDuration={500 + (index * 500)}>
            <a
              href={card.link || '#'}
              data-slot="link"
              class="flex flex-col items-center text-center gap-4 group p-6 rounded-lg border bg-card hover:bg-accent transition-colors h-full"
            >
            <div set:html={card.icon} />
            <div>
              <h2 class="text-lg font-semibold mb-2 group-hover:text-accent-foreground">
                {card.heading}
              </h2>
              <p class="text-sm text-muted-foreground">
                {card.description}
              </p>
            </div>
          </a>
         </AppearOnScrollWrapper>
        ))
      }
    </div>

    {blok.show_button && (
      <div class="pt-6">
        <Button client:load size="lg" variant="default" className="text-base px-8">
          {blok.button_text}
        </Button>
      </div>
    )}
  </div>
</section>
