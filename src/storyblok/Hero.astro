---
import { storyblokEditable } from "@storyblok/astro";
import { Button } from "@/components/atoms/button";
import AppearOnScrollWrapper from "@/components/atoms/AppearOnScrollWrapper";
const { blok } = Astro.props;
type Card = {
  icon?: string;

  heading?: string;

  description?: string;

  link?: string;
};
---

<section
  class="min-h-screen flex items-center justify-center px-4 relative overflow-hidden"
  {...storyblokEditable(blok)}
>
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src="/background-altered.png"
      alt="Willesden Green Surgery Building"
      class="absolute inset-0 h-full w-full object-fill animate-fade-in"
      style="object-position: center top;"
    />
    <div
      class="absolute inset-0 from-transparent via-background/40 to-background"
    >
    </div>
  </div>

  <div class="max-w-4xl mx-auto text-center space-y-12 relative z-10">
    <div class="space-y-6">
      <h1 class="text-5xl md:text-6xl font-bold tracking-tight">
        {blok.title}
      </h1>
      <p class="text-xl text-muted-foreground max-w-2xl mx-auto">
        {blok.subtitle}
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 max-w-3xl mx-auto">
      {
        blok.cards?.map((card: Card, index: number) => (
          <AppearOnScrollWrapper
            client:visible
            className="w-full h-full"
            transitionDuration={500 + index * 500}
          >
            <a
              href={card.link || "#"}
              data-slot="link"
              class="flex flex-col items-center text-center gap-4 group p-6 rounded-lg border bg-card/80 backdrop-blur-md hover:bg-accent/90 transition-all h-full shadow-lg"
            >
              <div class="[&_svg]:w-8 [&_svg]:h-8" set:html={card.icon} />
              <div>
                <h2 class="text-lg font-semibold mb-2 group-hover:text-accent-foreground">
                  {card.heading}
                </h2>
                <p class="text-sm text-muted-foreground">{card.description}</p>
              </div>
            </a>
          </AppearOnScrollWrapper>
        ))
      }
    </div>

    {
      blok.show_button && (
        <div class="pt-6">
          <Button
            client:load
            size="lg"
            variant="default"
            className="text-base px-8 backdrop-blur-md bg-primary/90 hover:bg-primary shadow-lg"
          >
            {blok.button_text}
          </Button>
        </div>
      )
    }
  </div>
</section>
