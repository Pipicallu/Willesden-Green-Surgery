---
/**
 * Storyblok schema:
 *   title      Text
 *   subtitle   Text (optional)
 *   categories Blocks — only allows: teamCategory
 *
 * teamCategory schema (nestable blok, no Astro file needed):
 *   label    Text
 *   members  Blocks — only allows: teamMemberCard
 */
import { storyblokEditable } from "@storyblok/astro";
import TeamDirectory from "@/components/organisms/TeamDirectory";

const { blok } = Astro.props;

const categories = (blok.categories ?? []).map((cat: any, categoryIndex: number) => ({
  id: cat._uid ?? `category-${categoryIndex}`,
  label: cat.label ?? "",
  members: (cat.members ?? []).map((m: any, memberIndex: number) => ({
    id: m._uid ?? `${cat._uid ?? categoryIndex}-${memberIndex}`,
    name: m.name ?? "",
    role: m.role ?? "",
    speciality: m.speciality || undefined,
    bio: m.bio || undefined,
    photo: m.photo?.filename || undefined,
  })),
}));
---

<section class="py-6 sm:py-10" {...storyblokEditable(blok)}>
  <div class="mb-10 space-y-3 sm:mb-12">
    <h2 class="text-3xl tracking-section text-primary sm:text-4xl">
      Meet the people behind your care
    </h2>
    {blok.subtitle && <p class="text-primary/80">{blok.subtitle}</p>}
  </div>
  <TeamDirectory client:visible categories={categories} />
</section>
