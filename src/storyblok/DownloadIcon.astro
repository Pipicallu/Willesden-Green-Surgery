---
import { storyblokEditable } from "@storyblok/astro";
const { blok } = Astro.props;
---

<div
  {...storyblokEditable(blok)}
  class="flex flex-row items-center justify-center gap-2 mt-8"
>
  <h2 class="text-xl font-medium">
    Download in person registration form here:
  </h2>
  <a
    href={blok.href || "#"}
    download="registration_form.pdf"
    class="text-primary underline inline-flex items-center gap-2"
  >
    <img
      src={blok.img?.filename}
      alt={blok.alt || "Download"}
      class="w-10 h-10"
    />
  </a>
</div>
