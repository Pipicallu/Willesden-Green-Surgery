---
import { storyblokEditable } from "@storyblok/astro";
const { blok } = Astro.props;

type DownloadIconSize = "small" | "medium" | "large";

const sizeMap: Record<DownloadIconSize, string> = {
  small: "h-16 w-16",
  medium: "h-32 w-32",
  large: "h-64 w-64",
};

const iconSize =
  sizeMap[(blok.sizing as DownloadIconSize) || "medium"] || sizeMap.medium;
---

<div
  {...storyblokEditable(blok)}
  class="mt-8 flex flex-row items-center justify-center gap-2"
>
  {blok.label && <h2>{blok.label}</h2>}
  <a
    href={blok.href || "#"}
    download={blok.filename || "registration_form.pdf"}
    class="inline-flex items-center gap-2 text-link underline hover:text-foreground transition-colors"
  >
    <span
      role="img"
      aria-label={blok.alt || "Download"}
      class={`block bg-icon ${iconSize}`}
      style={{
        mask: `url("${blok.img?.filename}") center / contain no-repeat`,
        "-webkit-mask": `url("${blok.img?.filename}") center / contain no-repeat`,
      }}
    />
  </a>
</div>
