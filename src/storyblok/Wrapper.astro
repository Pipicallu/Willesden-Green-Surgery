---
/**
 * Storyblok schema fields:
 *   width         (Single-option: narrow / medium / wide / full)          default: medium
 *   columns       (Single-option: 1 / 2)                                  default: 1
 *   spacing       (Single-option: none / sm / md / lg / xl)               default: md
 *   background    (Single-option: default / muted / card)                 default: default
 *   gap           (Single-option: tight / normal / loose)                 default: normal
 *   verticalAlign (Single-option: start / center / end)                   default: start
 *   body          (Blocks — nestable bloks)
 */
import { storyblokEditable } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import type {
  WrapperBackground,
  WrapperSpacing,
  WrapperMaxWidth,
  WrapperColumns,
  WrapperGap,
  WrapperVerticalAlign,
} from "@/components/organisms/Wrapper";

const { blok } = Astro.props;

const background: WrapperBackground = blok.background || "default";
const spacing: WrapperSpacing = blok.spacing || "md";
const maxWidth: WrapperMaxWidth = blok.width || "medium";
const columns: WrapperColumns =
  Number(blok.columns ?? blok.Columns) === 2 ? 2 : 1;
const gap: WrapperGap = blok.gap || "normal";
const vAlign: WrapperVerticalAlign = blok.verticalAlign || "start";

const backgroundClasses: Record<WrapperBackground, string> = {
  default: "",
  muted: "bg-muted",
  card: "bg-card border-y border-border",
};

const spacingClasses: Record<WrapperSpacing, string> = {
  none: "py-0",
  sm: "py-6",
  md: "py-12",
  lg: "py-20",
  xl: "py-32",
};

const widthClasses: Record<WrapperMaxWidth, string> = {
  narrow: "max-w-3xl mx-auto",
  medium: "max-w-5xl mx-auto",
  wide: "max-w-7xl mx-auto",
  full: "w-full",
};

const gapClasses: Record<WrapperGap, string> = {
  tight: "gap-3",
  normal: "gap-6",
  loose: "gap-12",
};

const vAlignClasses: Record<WrapperVerticalAlign, string> = {
  start: "items-start",
  center: "items-center",
  end: "items-end",
};

const columnClasses: Record<WrapperColumns, string> = {
  1: "grid-cols-1",
  2: "grid-cols-1 md:grid-cols-2",
};
---

<section
  {...storyblokEditable(blok)}
  class={`${backgroundClasses[background]} ${spacingClasses[spacing]}`}
>
  <div class={widthClasses[maxWidth]}>
    <div
      class={`grid ${columnClasses[columns]} ${gapClasses[gap]} ${vAlignClasses[vAlign]}`}
    >
      {
        blok.body?.map((nestedBlok: any) => (
          <StoryblokComponent blok={nestedBlok} />
        ))
      }
    </div>
  </div>
</section>
