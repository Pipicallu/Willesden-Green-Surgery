---
import { storyblokEditable } from "@storyblok/astro";
import AppearOnScrollWrapper from "@/components/atoms/AppearOnScrollWrapper";
const { blok } = Astro.props;
---

<section class="py-20 px-4 bg-muted/50" {...storyblokEditable(blok)}>
  <div class="max-w-6xl mx-auto">
    <div class="text-center space-y-4 mb-12">
      <h2 class="text-3xl md:text-4xl font-bold">{blok.title}</h2>
      <p class="text-xl text-muted-foreground">{blok.subtitle}</p>
    </div>
    <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-6">
      {
        blok.members?.map((member: any, index: number) => (
          <AppearOnScrollWrapper
            client:visible
            transitionDuration={2000 - index * 500}
            className="p-6 rounded-lg border bg-card text-center space-y-3"
          >
            {member.photo?.filename ? (
              <img
                src={member.photo.filename}
                alt={member.name}
                class="w-24 h-24 mx-auto rounded-full object-cover"
              />
            ) : (
              <div class="w-24 h-24 mx-auto rounded-full bg-muted" />
            )}
            <h3 class="font-semibold">{member.name}</h3>
            <p class="text-sm text-muted-foreground">{member.role}</p>
          </AppearOnScrollWrapper>
        ))
      }
    </div>
  </div>
</section>
