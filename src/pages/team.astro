---
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import { storyblokEditable, type SbBlokData } from "@storyblok/astro";
import Layout from "@/layouts/Layout.astro";

const storyblokApi = useStoryblokApi();
const { data } = await storyblokApi.get("cdn/stories/team", {
  version: import.meta.env.DEV ? "draft" : "published",
});

const story = data.story;
---

<Layout>
  <main class="page-gradient mx-auto max-w-6xl pb-12 pt-4 md:pt-20 lg:pt-0" {...storyblokEditable(story.content)}>
    <section
      class="grid items-center gap-8 py-10 sm:py-14 lg:grid-cols-[0.9fr_1.1fr] lg:gap-12 lg:py-20"
      aria-labelledby="team-title"
    >
      <div>
        <p class="small-label mb-5 uppercase tracking-[0.16em] text-icon">
          Serving our community since 1997
        </p>
        <h1
          id="team-title"
          class="text-4xl leading-[1.08] tracking-hero text-primary sm:text-5xl lg:text-6xl"
        >
          Local people.<br />Personal care.
        </h1>
        <div class="my-7 h-1 w-16 bg-icon" aria-hidden="true"></div>
        <p class="max-w-lg text-lg leading-relaxed text-primary/80 sm:text-xl">
          From your first conversation with reception to specialist care, meet
          the people who make our practice.
        </p>
      </div>
      <figure class="min-w-0">
        <img
          src="/team-image.png"
          alt="The Willesden Green Surgery team waving outside the practice"
          width="765"
          height="393"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full rounded-lg"
        />
        <figcaption class="mt-3 text-primary/80">
          Willesden Green Surgery
        </figcaption>
      </figure>
    </section>
    {
      story.content.body?.map((blok: SbBlokData) => (
        <StoryblokComponent blok={blok} />
      ))
    }
  </main>
</Layout>
