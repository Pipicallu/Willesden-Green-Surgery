---
// @ts-nocheck
import Layout from "../layouts/Layout.astro";
import { Button } from "@/components/atoms/button";
import { Banner } from "@/components/molecules/Banner";
import AutoCarousel from "@/components/organisms/AutoCarousel";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import { getStory } from "@/lib/storyblok";
import type { SbBlokData } from "@storyblok/astro";
import NumberCounter from "@/components/atoms/NumberCounter";
import MapSection from "@/components/organisms/MapSection";
import SpecialistsSection from "@/components/molecules/SpecialistsSection";
const story = await getStory("home");
---

<Layout>
  <!-- Hero Section - From Storyblok -->
  {story.content.body
    ?.filter((blok: SbBlokData) => blok.component === "Hero")
    .map((blok: SbBlokData) => (
      <StoryblokComponent blok={blok} />
    ))}

  <!-- Accurx Section -->
  <section
    class="relative z-10 px-4 py-10 sm:px-6 lg:py-20"
    aria-labelledby="contact-online-title"
  >
    <div class="mx-auto max-w-6xl rounded-2xl border border-primary/20 bg-card/90 p-6 shadow-md sm:p-8 lg:p-10">
      <div class="flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
        <div class="max-w-2xl space-y-3">
          <h2 id="contact-online-title" class="sr-only">
            Contact us online
          </h2>
          <p class="small-label uppercase tracking-[0.18em] text-foreground">
            Contact the practice
          </p>
          <h3 class="card-title leading-snug text-foreground">
            Submit an online consultation
          </h3>
          <p class="text-muted-foreground">
            Available 27h 7d for appointments, sick notes and administrative
            issues
          </p>
        </div>

        <Button
          href="https://accurx.nhs.uk/patient-initiated/E84702"
          size="lg"
          variant="outline"
          className="h-auto min-h-14 w-full flex-col gap-1 border-secondary bg-card px-5 py-3 text-link hover:bg-muted hover:text-foreground sm:w-fit sm:flex-row sm:gap-3 lg:shrink-0"
        >
          <span>Start an online request</span>
          <img src="/accurx-logo.png" alt="Accurx" class="h-5 w-auto" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Statistics Section -->
  <section
    class="rounded-lg bg-muted px-4 py-6 sm:py-10 md:px-10 lg:py-20"
    aria-labelledby="statistics-title"
  >
    <div class="max-w-6xl mx-auto">
      <div class="mb-4 space-y-2 text-left sm:mb-12 sm:space-y-4 md:text-center">
        <h2 id="statistics-title" class="text-2xl md:text-section">Our impact in numbers</h2>
        <p class="hidden text-muted-foreground sm:block">
          Committed to doing our best for the local Willesden Green community.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-2 sm:gap-8 lg:grid-cols-3">
        <div class="flex flex-col items-start gap-1.5 rounded-lg border border-border bg-card p-3 text-left shadow-sm sm:block sm:space-y-4 sm:p-8">
          <NumberCounter
            client:visible
            target={24}
            suffix="/7"
            className="text-3xl font-bold leading-none tabular-nums text-foreground sm:text-5xl"
          />
          <h3 class="font-sans text-sm font-semibold leading-snug tracking-normal sm:text-card-title sm:leading-[1.3]">Online Consultation Access</h3>
          <p class="hidden text-muted-foreground sm:block">That we never switch off</p>
        </div>
        <div class="flex flex-col items-start gap-1.5 rounded-lg border border-border bg-card p-3 text-left shadow-sm sm:block sm:space-y-4 sm:p-8">
          <NumberCounter
            client:visible
            duration={2000}
            target={80}
            suffix="%"
            className="text-3xl font-bold leading-none tabular-nums text-foreground sm:text-5xl"
          />
          <h3 class="font-sans text-sm font-semibold leading-snug tracking-normal sm:text-card-title sm:leading-[1.3]">More GP Appointments</h3>
          <p class="hidden text-muted-foreground sm:block">
            Per patient compared to the national average
          </p>
        </div>
        <div class="flex flex-col items-start gap-1.5 rounded-lg border border-border bg-card p-3 text-left shadow-sm sm:block sm:space-y-4 sm:p-8">
          <NumberCounter
            client:visible
            target={90}
            suffix="%"
            className="text-3xl font-bold leading-none tabular-nums text-foreground sm:text-5xl"
          />
          <h3 class="font-sans text-sm font-semibold leading-snug tracking-normal sm:text-card-title sm:leading-[1.3]">Good Patient Rating</h3>
          <p class="hidden text-muted-foreground sm:block">
            In the national GP patient survey. One of the highest in England.
          </p>
        </div>
        <div class="flex flex-col items-start gap-1.5 rounded-lg border border-border bg-card p-3 text-left shadow-sm sm:block sm:space-y-4 sm:p-8">
          <NumberCounter
            client:visible
            reverse
            target={2}
            suffix=" min"
            className="text-3xl font-bold leading-none tabular-nums text-foreground sm:text-5xl"
          />
          <h3 class="font-sans text-sm font-semibold leading-snug tracking-normal sm:text-card-title sm:leading-[1.3]">Average Call Wait</h3>
          <p class="hidden text-muted-foreground sm:block">With callback options</p>
        </div>
        <div class="flex flex-col items-start gap-1.5 rounded-lg border border-border bg-card p-3 text-left shadow-sm sm:block sm:space-y-4 sm:p-8">
          <NumberCounter
            client:visible
            reverse
            target={1}
            suffix="st"
            className="text-3xl font-bold leading-none tabular-nums text-foreground sm:text-5xl"
          />
          <h3 class="font-sans text-sm font-semibold leading-snug tracking-normal sm:text-card-title sm:leading-[1.3]">Ultrasound Guided Surgery</h3>
          <p class="hidden text-muted-foreground sm:block">
            First GP practice in the UK to provide this service
          </p>
        </div>
        <div class="flex flex-col items-start gap-1.5 rounded-lg border border-border bg-card p-3 text-left shadow-sm sm:block sm:space-y-4 sm:p-8">
          <NumberCounter
            client:visible
            target={65}
            suffix="%"
            className="text-3xl font-bold leading-none tabular-nums text-foreground sm:text-5xl"
          />
          <h3 class="font-sans text-sm font-semibold leading-snug tracking-normal sm:text-card-title sm:leading-[1.3]">Early Cancer Detection</h3>
          <p class="hidden text-muted-foreground sm:block">
            5 year rolling rate, one of the highest in London.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!--Team video section-->
  <section class="py-10 lg:py-20">
    <div class="max-w-6xl mx-auto">
      <div class="relative group rounded-lg shadow-lg cursor-pointer transition-all duration-500 ease-in-out lg:hover:scale-110 lg:hover:my-12">
        <video autoplay loop muted playsinline class="w-full rounded-lg">
          <source src="/team.mp4" type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-primary/25 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-lg">
          <div class="absolute inset-0 flex items-center justify-center opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-500">
            <Button
              client:load
              size="lg"
              className="pointer-events-auto text-primary-foreground text-base px-8"
            >
              <a href="/team">Meet the Team</a>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Specialists section -->
  <SpecialistsSection client:load />

  <!-- Meet the Team Section - From Storyblok -->
  <!-- {
    story.content.body
      ?.filter((blok: SbBlokData) => blok.component === "team")
      .map((blok: SbBlokData) => <StoryblokComponent blok={blok} />)
  } -->

  <!-- Map Section -->
  <MapSection client:load />
  <!-- Carousel Section -->
  <section class="bg-muted py-10 lg:py-20 overflow-hidden border-rounded rounded-lg">
    <div class="max-w-6xl mx-auto">
      <div class="px-4 text-left md:px-0 md:text-center space-y-4 mb-12">
        <h2 class="text-2xl md:text-section">Our accreditations and awards</h2>
        <p class="text-muted-foreground">
          The commitments and recognition behind our practice
        </p>
      </div>
      <AutoCarousel client:load />
    </div>
  </section>
</Layout>
