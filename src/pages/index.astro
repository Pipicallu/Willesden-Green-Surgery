---
// @ts-nocheck
import Layout from "../layouts/Layout.astro";
import { Button } from "@/components/atoms/button";
import { Banner } from "@/components/molecules/Banner";
import AutoCarousel from "@/components/organisms/AutoCarousel";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import { getStory } from "@/lib/storyblok";
import type { SbBlokData } from "@storyblok/astro";
import NumberCounter from "@/components/atoms/NumberCounter";
import MapSection from "@/components/organisms/MapSection";
const story = await getStory("home");
---

<Layout>
  <!-- Hero Section - From Storyblok -->
  {
    story.content.body
      ?.filter((blok: SbBlokData) => blok.component === "Hero")
      .map((blok: SbBlokData) => <StoryblokComponent blok={blok} />)
  }

  <!-- Accurx Section -->
  <section
    class="relative z-10 px-4 pb-12 sm:px-6 lg:pb-16"
    aria-labelledby="contact-online-title"
  >
    <div
      class="mx-auto max-w-6xl rounded-2xl border border-primary/20 bg-card/90 p-6 shadow-sm sm:p-8 lg:p-10"
    >
      <div
        class="flex flex-col gap-7 lg:flex-row lg:items-center lg:justify-between lg:gap-10"
      >
        <div class="max-w-2xl space-y-3">
          <h2 id="contact-online-title" class="sr-only">Contact us online</h2>
          <p
            class="small-label uppercase tracking-[0.18em] text-foreground"
          >
            Contact the practice
          </p>
          <h3
            class="card-title leading-snug text-foreground"
          >
            Submit an online consultation
          </h3>
          <p class="text-muted-foreground">
            Available 27h 7d for appointments, sick notes and administrative
            issues
          </p>
        </div>

        <Button
          href="https://accurx.nhs.uk/patient-initiated/E84702"
          size="lg"
          variant="outline"
          className="h-auto min-h-14 w-full flex-col gap-1 border-secondary bg-card px-5 py-3 text-link hover:bg-muted hover:text-foreground sm:w-fit sm:flex-row sm:gap-3 lg:shrink-0"
        >
          <span>Start an online request</span>
          <img src="/accurx-logo.png" alt="Accurx" class="h-5 w-auto" />
        </Button>
      </div>
    </div>
  </section>

  <!-- Statistics Section -->
  <section class="bg-muted pt-10 pb-20">
    <div class="max-w-6xl mx-auto">
      <div class="text-center space-y-4 mb-12">
        <h2>Our impact in numbers</h2>
        <p class="text-muted-foreground">
          Committed to doing our best for the local Willesden Green community.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div
          class="text-center space-y-4 rounded-lg border border-border bg-card p-8 shadow-sm"
        >
          <NumberCounter
            client:visible
            target={24}
            suffix="/7"
            className="text-5xl font-bold text-foreground"
          />
          <h3 class="card-title">Online Consultation Access</h3>
          <p class="text-muted-foreground">That we never switch off</p>
        </div>
        <div
          class="text-center space-y-4 rounded-lg border border-border bg-card p-8 shadow-sm"
        >
          <NumberCounter
            client:visible
            duration={2000}
            target={80}
            suffix="%"
            className="text-5xl font-bold text-foreground"
          />
          <h3 class="card-title">More GP Appointments</h3>
          <p class="text-muted-foreground">
            Per patient compared to the national average
          </p>
        </div>
        <div
          class="text-center space-y-4 rounded-lg border border-border bg-card p-8 shadow-sm"
        >
          <NumberCounter
            client:visible
            target={90}
            suffix="%"
            className="text-5xl font-bold text-foreground"
          />
          <h3 class="card-title">Good Patient Rating</h3>
          <p class="text-muted-foreground">
            In the national GP patient survey. One of the highest in England.
          </p>
        </div>
        <div
          class="text-center space-y-4 rounded-lg border border-border bg-card p-8 shadow-sm"
        >
          <NumberCounter
            client:visible
            reverse
            target={2}
            suffix=" min"
            className="text-5xl font-bold text-foreground"
          />
          <h3 class="card-title">Average Call Wait</h3>
          <p class="text-muted-foreground">With callback options</p>
        </div>
        <div
          class="text-center space-y-4 rounded-lg border border-border bg-card p-8 shadow-sm"
        >
          <NumberCounter
            client:visible
            reverse
            target={1}
            suffix="st"
            className="text-5xl font-bold text-foreground"
          />
          <h3 class="card-title">Ultrasound Guided Surgery</h3>
          <p class="text-muted-foreground">
            First GP practice in the UK to provide this service
          </p>
        </div>
        <div
          class="text-center space-y-4 rounded-lg border border-border bg-card p-8 shadow-sm"
        >
          <NumberCounter
            client:visible
            target={65}
            suffix="%"
            className="text-5xl font-bold text-foreground"
          />
          <h3 class="card-title">Early Cancer Detection</h3>
          <p class="text-muted-foreground">
            5 year rolling rate, one of the highest in London.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!--Team video section-->
  <section class="pt-10 pb-20 lg:py-20">
    <div class="max-w-6xl mx-auto">
      <div
        class="relative group rounded-lg shadow-lg cursor-pointer transition-all duration-500 ease-in-out lg:hover:scale-150 lg:hover:my-12"
      >
        <video autoplay loop muted playsinline class="w-full rounded-lg">
          <source src="/team.mp4" type="video/mp4" />
        </video>
        <div
          class="absolute inset-0 bg-primary/25 opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none rounded-lg"
        >
          <div
            class="absolute inset-0 flex items-center justify-center opacity-100 lg:opacity-0 lg:group-hover:opacity-100 transition-opacity duration-500"
          >
            <Button
              client:load
              size="lg"
              className="pointer-events-auto text-primary-foreground text-base px-8"
            >
              <a href="/team">Meet the Team</a>
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Meet the Team Section - From Storyblok -->
  <!-- {
    story.content.body
      ?.filter((blok: SbBlokData) => blok.component === "team")
      .map((blok: SbBlokData) => <StoryblokComponent blok={blok} />)
  } -->

  <!-- Map Section -->
  <MapSection client:load />
  <!-- Carousel Section -->
  <section class="bg-muted py-10 lg:py-20 overflow-hidden">
    <div class="max-w-6xl mx-auto">
      <div class="text-center space-y-4 mb-12">
        <h2>
          Our accreditations and awards
        </h2>
        <p class="text-muted-foreground">
          The commitments and recognition behind our practice
        </p>
      </div>
      <AutoCarousel client:load />
    </div>
  </section>
</Layout>
