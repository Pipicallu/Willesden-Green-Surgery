---
import Layout from '../layouts/Layout.astro';
import { Button } from "@/components/ui/button"
import AutoCarousel from '../components/AutoCarousel';
---

<Layout>
	<!-- Hero Section -->
	<section class="min-h-screen flex items-center justify-center px-4">
		<div class="max-w-4xl mx-auto text-center space-y-12">
			<div class="space-y-6">
				<h1 class="text-5xl md:text-6xl font-bold tracking-tight">
					Welcome to Your Healthcare Portal
				</h1>
				<p class="text-xl text-muted-foreground max-w-2xl mx-auto">
					Access your healthcare services quickly and securely
				</p>
			</div>

			<div class="grid md:grid-cols-3 gap-6 max-w-3xl mx-auto">
				<a href="#" class="group p-6 rounded-lg border bg-card hover:bg-accent transition-colors">
					<h2 class="text-lg font-semibold mb-2 group-hover:text-accent-foreground">
						Book An Appointment
					</h2>
					<p class="text-sm text-muted-foreground">
						Schedule your next visit
					</p>
				</a>

				<a href="#" class="group p-6 rounded-lg border bg-card hover:bg-accent transition-colors">
					<h2 class="text-lg font-semibold mb-2 group-hover:text-accent-foreground">
						Manage Your Prescription
					</h2>
					<p class="text-sm text-muted-foreground">
						View and renew prescriptions
					</p>
				</a>

				<a href="#" class="group p-6 rounded-lg border bg-card hover:bg-accent transition-colors">
					<h2 class="text-lg font-semibold mb-2 group-hover:text-accent-foreground">
						Check Your Test Results
					</h2>
					<p class="text-sm text-muted-foreground">
						Access your latest results
					</p>
				</a>
			</div>

			<div class="pt-6">
				<Button client:load size="lg" variant='default' className="text-base px-8">
					Download NHS App
				</Button>
			</div>
		</div>
	</section>

	<!-- Contact Us Section -->
	<section class="py-20 px-4 bg-muted/50">
		<div class="max-w-4xl mx-auto">
			<div class="flex flex-col md:flex-row items-center justify-between gap-8">
				<div class="flex-1 space-y-4">
					<h2 class="text-3xl md:text-4xl font-bold">
						Contact us online for appointments and administration issues!
					</h2>
				</div>
				<div class="flex-shrink-0">
					<Button client:load size="lg" className="text-base px-8">
						AccuRx Portal
					</Button>
				</div>
			</div>
		</div>
	</section>

	<!-- Statistics Section -->
	<section class="py-20 px-4">
		<div class="max-w-6xl mx-auto">
			<div class="text-center space-y-4 mb-12">
				<h2 class="text-3xl md:text-4xl font-bold">Our Achievements</h2>
				<p class="text-xl text-muted-foreground">Excellence in healthcare delivery</p>
			</div>
			<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
				<div class="text-center space-y-4 p-8 rounded-lg border bg-card">
					<div class="text-5xl font-bold text-primary">24/7</div>
					<h3 class="text-xl font-semibold">Online Consultation Access</h3>
					<p class="text-muted-foreground">That we never switch off</p>
				</div>
				<div class="text-center space-y-4 p-8 rounded-lg border bg-card">
					<div class="text-5xl font-bold text-primary">60%</div>
					<h3 class="text-xl font-semibold">More GP Appointments</h3>
					<p class="text-muted-foreground">Per patient compared to the national average</p>
				</div>
				<div class="text-center space-y-4 p-8 rounded-lg border bg-card">
					<div class="text-5xl font-bold text-primary">95%</div>
					<h3 class="text-xl font-semibold">Good Patient Rating</h3>
					<p class="text-muted-foreground">In both national GP and friends and family test</p>
				</div>
				<div class="text-center space-y-4 p-8 rounded-lg border bg-card">
					<div class="text-5xl font-bold text-primary">2 min</div>
					<h3 class="text-xl font-semibold">Average Call Wait</h3>
					<p class="text-muted-foreground">With callback options</p>
				</div>
				<div class="text-center space-y-4 p-8 rounded-lg border bg-card">
					<div class="text-5xl font-bold text-primary">1st</div>
					<h3 class="text-xl font-semibold">Ultrasound Guided Surgery</h3>
					<p class="text-muted-foreground">GP practice in the UK to provide this service</p>
				</div>
				<div class="text-center space-y-4 p-8 rounded-lg border bg-card">
					<div class="text-5xl font-bold text-primary">65%+</div>
					<h3 class="text-xl font-semibold">Early Cancer Detection</h3>
					<p class="text-muted-foreground">5 year rolling rate, the highest in Brent</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Meet the Team Section -->
	<section class="py-20 px-4 bg-muted/50">
		<div class="max-w-6xl mx-auto">
			<div class="text-center space-y-4 mb-12">
				<h2 class="text-3xl md:text-4xl font-bold">Meet the Team</h2>
				<p class="text-xl text-muted-foreground">Our dedicated healthcare professionals</p>
			</div>
			<div class="grid md:grid-cols-3 lg:grid-cols-4 gap-6">
				{/* Team member cards will go here */}
				<div class="p-6 rounded-lg border bg-card text-center space-y-3">
					<div class="w-24 h-24 mx-auto rounded-full bg-muted"></div>
					<h3 class="font-semibold">Team Member</h3>
					<p class="text-sm text-muted-foreground">Role</p>
				</div>
				<div class="p-6 rounded-lg border bg-card text-center space-y-3">
					<div class="w-24 h-24 mx-auto rounded-full bg-muted"></div>
					<h3 class="font-semibold">Team Member</h3>
					<p class="text-sm text-muted-foreground">Role</p>
				</div>
				<div class="p-6 rounded-lg border bg-card text-center space-y-3">
					<div class="w-24 h-24 mx-auto rounded-full bg-muted"></div>
					<h3 class="font-semibold">Team Member</h3>
					<p class="text-sm text-muted-foreground">Role</p>
				</div>
				<div class="p-6 rounded-lg border bg-card text-center space-y-3">
					<div class="w-24 h-24 mx-auto rounded-full bg-muted"></div>
					<h3 class="font-semibold">Team Member</h3>
					<p class="text-sm text-muted-foreground">Role</p>
				</div>
			</div>
		</div>
	</section>


	<!-- Map Section -->
	<section class="py-20 px-4">
		<div class="max-w-6xl mx-auto">
			<div class="text-center space-y-4 mb-12">
				<h2 class="text-3xl md:text-4xl font-bold">Find Us</h2>
				<p class="text-xl text-muted-foreground">Visit our practice location</p>
			</div>
			<div class="rounded-lg border overflow-hidden bg-muted h-96">
				{/* Google Maps will be integrated here */}
				<div class="w-full h-full flex items-center justify-center text-muted-foreground">
					Map will be displayed here
				</div>
			</div>
		</div>
	</section>
		<!-- Carousel Section -->
	<section class="py-20 px-4 bg-muted/50">
		<div class="max-w-6xl mx-auto">
			<div class="text-center space-y-4 mb-12">
				<h2 class="text-3xl md:text-4xl font-bold">Why Choose Us</h2>
				<p class="text-xl text-muted-foreground">Discover what makes us different</p>
			</div>
			<AutoCarousel client:load />
		</div>
	</section>
</Layout>