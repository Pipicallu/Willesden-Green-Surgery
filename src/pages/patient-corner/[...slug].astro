---
// @ts-nocheck
import { useStoryblokApi } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
  const storyblokApi = useStoryblokApi();
  const { data } = await storyblokApi.get("cdn/links/");
  const links = data.links;

  const paths = Object.keys(links)
    .map((key) => links[key])
    .filter((link) => link.slug && link.slug.startsWith("patient-corner/"))
    .map((link) => {
      const slugPath = link.slug.replace("patient-corner/", "");
      const slugArray = slugPath.split("/").filter(Boolean);
      console.log("Processing:", link.slug, "->", slugArray);
      return {
        params: {
          slug: slugArray.join("/"),
        },
      };
    });

  return paths;
}

const storyblokApi = useStoryblokApi();
const { slug } = Astro.params;

// For [...slug] route, slug is already a string like "safe-surgeries" or "safe-surgeries/sub-page"
const fullPath = `patient-corner/${slug}`;

const { data } = await storyblokApi.get(`cdn/stories/${fullPath}`, {
  version: "draft",
});

const story = data.story;
---

<Layout>
  <section class="pt-32 pb-20 px-4 max-w-6xl mx-auto">
    <div class="max-w-4xl mx-auto text-center space-y-4 mb-12">
      <h1 class="text-4xl md:text-5xl font-bold">{story.content.Title}</h1>
      {
        story.content.Subtitle && (
          <p class="text-xl text-muted-foreground">{story.content.Subtitle}</p>
        )
      }
    </div>

    <StoryblokComponent blok={story.content} />
  </section>
</Layout>
